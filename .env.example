# --- Database ---------------------------------------------------------------
# Sviluppo locale (SQLite):
DATABASE_URL="file:./dev.db"
# Deploy (PostgreSQL, es. Supabase): decommenta e usa lo schema Postgres
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://utente:password@host:5432/kanjiflow?sslmode=require"

# --- Autenticazione (obbligatoria per qualsiasi deploy raggiungibile da Internet) ---
# Genera entrambi i valori con:  npm run auth:hash -- "una-password-lunga"
# In locale, se lasci vuoto APP_PASSWORD_HASH_B64, l'accesso è libero.
APP_PASSWORD_HASH_B64=""
SESSION_SECRET=""
