// KanjiFlow — schema relazionale.
// Portabilità SQLite (sviluppo) ↔ PostgreSQL (deploy): niente enum nativi né Json nativo.
// I valori "enum" sono stringhe validate dal dominio (src/domain/*) e da Zod;
// i campi strutturati (impostazioni SRS, notifiche) sono JSON serializzato in String.
// Lo schema Postgres viene generato da questo file: `npm run db:pg:schema`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String   @id @default(cuid())
  displayName       String
  interfaceLanguage String   @default("it")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  settings     UserSettings?
  progress     UserSubjectProgress[]
  sessions     ReviewSession[]
  transitions  ReviewTransition[]
  notes        UserNote[]
  activities   StudyActivity[]
  collections  StudyCollection[]
  mnemonics    Mnemonic[]
  userMeanings SubjectMeaning[]
}

model UserSettings {
  userId                  String   @id
  dailyLessonLimit        Int      @default(15)
  lessonBatchSize         Int      @default(5)
  maxApprenticeItems      Int      @default(120)
  studyPath               String   @default("jlpt") // guided | jlpt | custom
  targetJlpt              String   @default("N3")
  typoTolerance           String   @default("conservative") // off | conservative | lenient
  questionPriority        String   @default("balanced") // balanced | meaning_first | reading_first
  showFurigana            Boolean  @default(true)
  showRomajiHints         Boolean  @default(false)
  theme                   String   @default("dark") // dark | light | system
  timezone                String   @default("Europe/Rome")
  notificationPreferences String   @default("{}") // JSON
  srsConfiguration        String   @default("{}") // JSON: intervalli per stadio, arrotondamento
  activeCollectionId      String?
  onboardingCompletedAt   DateTime?
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentSource {
  id          String   @id @default(cuid())
  key         String   @unique // es. "kanjidic2", "jmdict-examples", "kanjiflow-generated"
  name        String
  url         String?
  license     String
  attribution String
  version     String
  importedAt  DateTime @default(now())

  subjects        Subject[]
  examples        ExampleSentence[]
  classifications SubjectClassification[]
}

model Subject {
  id              String   @id @default(cuid())
  type            String // radical | kanji | vocabulary
  slug            String   @unique // stabile tra import: "kanji:識", "vocab:覚ます:さます", "radical:言"
  characters      String
  primaryMeaning  String // significato primario in italiano (cache denormalizzata per elenchi)
  lessonOrder     Int
  strokeCount     Int?
  frequencyRank   Int?
  partOfSpeech    String? // JSON array di tag JMdict per il vocabolario
  usageNotes      String?
  contentSourceId String
  contentVersion  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contentSource   ContentSource           @relation(fields: [contentSourceId], references: [id])
  meanings        SubjectMeaning[]
  readings        SubjectReading[]
  components      SubjectComponent[]      @relation("parent")
  usedIn          SubjectComponent[]      @relation("component")
  mnemonics       Mnemonic[]
  examples        ExampleSentence[]
  classifications SubjectClassification[]
  collections     CollectionSubject[]
  progress        UserSubjectProgress[]
  attempts        ReviewAttempt[]
  transitions     ReviewTransition[]
  notes           UserNote[]
  activities      StudyActivity[]

  @@index([type, lessonOrder])
  @@index([characters])
}

model SubjectMeaning {
  id         String  @id @default(cuid())
  subjectId  String
  userId     String? // valorizzato solo per sinonimi aggiunti dall'utente (mai toccati dagli import)
  language   String // it | en
  meaning    String
  isPrimary  Boolean @default(false)
  isAccepted Boolean @default(true)
  origin     String // dictionary | generated | user
  verified   Boolean @default(false)
  position   Int     @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectId, language, meaning, origin])
  @@index([meaning])
}

model SubjectReading {
  id          String  @id @default(cuid())
  subjectId   String
  reading     String // sempre in hiragana normalizzato (NFC)
  readingType String // onyomi | kunyomi | nanori | vocabulary
  isPrimary   Boolean @default(false)
  isAccepted  Boolean @default(true)
  position    Int     @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, readingType, reading])
  @@index([reading])
}

model SubjectComponent {
  parentSubjectId    String
  componentSubjectId String
  relationshipType   String // radical_of_kanji | kanji_of_vocabulary

  parent    Subject @relation("parent", fields: [parentSubjectId], references: [id], onDelete: Cascade)
  component Subject @relation("component", fields: [componentSubjectId], references: [id], onDelete: Cascade)

  @@id([parentSubjectId, componentSubjectId])
  @@index([componentSubjectId])
}

model Mnemonic {
  id           String   @id @default(cuid())
  subjectId    String
  userId       String? // presente = mnemonico personale (mai sovrascritto dagli import)
  mnemonicType String // meaning | reading
  language     String   @default("it")
  content      String
  sourceType   String // generated | user | curated
  updatedAt    DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subjectId, mnemonicType])
}

model ExampleSentence {
  id                  String  @id @default(cuid())
  subjectId           String
  japaneseText        String
  kanaText            String?
  translatedText      String
  translationLanguage String // en (fonte verificata) | it (generata)
  sourceId            String
  externalId          String? // id Tatoeba
  verified            Boolean @default(false)

  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  source  ContentSource @relation(fields: [sourceId], references: [id])

  @@unique([subjectId, sourceId, japaneseText])
}

model StudyCollection {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  collectionType String // custom | imported | system
  createdAt      DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects CollectionSubject[]

  @@unique([userId, name])
}

model CollectionSubject {
  collectionId String
  subjectId    String
  position     Int

  collection StudyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([collectionId, subjectId])
}

model SubjectClassification {
  id                   String @id @default(cuid())
  subjectId            String
  classificationSystem String // es. "jlpt-waller" (non ufficiale), "jlpt-old-kanjidic", "jouyou-grade"
  classificationValue  String // es. "N3"
  sourceId             String
  confidence           String // official | community | derived

  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  source  ContentSource @relation(fields: [sourceId], references: [id])

  @@unique([subjectId, classificationSystem])
  @@index([classificationSystem, classificationValue])
}

model UserSubjectProgress {
  id                    String    @id @default(cuid())
  userId                String
  subjectId             String
  srsStage              Int       @default(0) // 0 = sbloccato, lezione da fare; 1-8 apprendimento; 9 = bruciato
  unlockedAt            DateTime?
  lessonCompletedAt     DateTime?
  nextReviewAt          DateTime?
  burnedAt              DateTime?
  suspendedAt           DateTime?
  markedKnownAt         DateTime?
  meaningCorrectCount   Int       @default(0)
  meaningIncorrectCount Int       @default(0)
  readingCorrectCount   Int       @default(0)
  readingIncorrectCount Int       @default(0)
  updatedAt             DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId, nextReviewAt])
  @@index([userId, srsStage])
}

model ReviewSession {
  id          String    @id @default(cuid())
  userId      String
  kind        String    @default("review") // review | lesson_quiz | extra_study
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("active") // active | completed | abandoned

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts    ReviewAttempt[]
  transitions ReviewTransition[]

  @@index([userId, status])
}

model ReviewAttempt {
  id               String   @id @default(cuid())
  clientAttemptId  String   @unique // idempotenza: lo stesso tentativo inviato due volte viene registrato una sola volta
  sessionId        String
  subjectId        String
  questionType     String // meaning | reading
  submittedAnswer  String
  normalizedAnswer String
  isCorrect        Boolean
  outcome          String // exact | synonym | typo | override | incorrect | wrong_reading_type | other_subject
  overridden       Boolean  @default(false)
  responseTimeMs   Int
  attemptedAt      DateTime @default(now())

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([sessionId, subjectId])
  @@index([subjectId, attemptedAt])
  @@index([attemptedAt])
}

model ReviewTransition {
  id               String   @id @default(cuid())
  subjectId        String
  userId           String
  sessionId        String
  previousStage    Int
  nextStage        Int
  meaningIncorrect Int      @default(0)
  readingIncorrect Int      @default(0)
  scheduledAt      DateTime? // null se bruciato
  createdAt        DateTime @default(now())

  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Un soggetto passa di stadio al massimo una volta per sessione: impedisce doppie programmazioni.
  @@unique([sessionId, subjectId])
  @@index([userId, createdAt])
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model StudyActivity {
  id           String   @id @default(cuid())
  userId       String
  activityType String // lesson_completed | review_completed | marked_known | resurrected | reset | suspended
  subjectId    String?
  localDate    String // AAAA-MM-GG nel fuso dell'utente, per heatmap e streak
  timestamp    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, localDate])
  @@index([userId, activityType, timestamp])
}
